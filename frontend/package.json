    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/cytoscape": "3.31.0",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
